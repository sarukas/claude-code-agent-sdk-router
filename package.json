{
  "name": "claude-code-agent-sdk-router",
  "version": "0.1.1",
  "description": "Minimal, auditable Claude Code and Agent SDK router — Anthropic · OpenRouter · Gemini · OpenAI · Groq · Mistral · Ollama",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./gateway": {
      "require": "./dist/core/server.js",
      "types": "./dist/core/server.d.ts"
    }
  },
  "bin": {
    "ccasr": "dist/cli.js"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "setup": "tsx src/cli.ts setup",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/runner.ts",
    "test:provider": "tsx tests/runner.ts http://127.0.0.1:3456",
    "audit:security": "grep -rn 'vm\\.runInContext\\|vm\\.createContext\\|require(.*path\\|new Function(' src/ && echo 'FAIL: dynamic code found' || echo 'PASS: no dynamic code'"
  },
  "keywords": [
    "claude-code",
    "agent-sdk",
    "llm-router",
    "anthropic",
    "openrouter",
    "gemini",
    "openai",
    "groq",
    "mistral",
    "ollama"
  ],
  "author": "sarukas",
  "license": "MIT",
  "dependencies": {
    "fastify": "5.7.4",
    "json5": "2.2.3",
    "jsonrepair": "3.12.0",
    "pino": "9.6.0",
    "pino-roll": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
