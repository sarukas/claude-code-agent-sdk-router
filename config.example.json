{
  // Emit request/response bodies to stdout. Keep false in production.
  "LOG": false,

  // Timeout for outbound API calls (ms)
  "API_TIMEOUT_MS": 300000,

  // Port the proxy listens on (must match ANTHROPIC_BASE_URL)
  "PORT": 3456,

  // Optional: route all outbound requests through an HTTP proxy
  // "PROXY_URL": "http://your-corporate-proxy:8080",

  // File logging — writes to ~/.ccasr/logs/ccasr.log with rotation
  // "LOG_FILE": true,        // default: true (set false to disable file logging)
  // "LOG_MAX_SIZE": "10m",   // rotate at this size (default: 10m)
  // "LOG_MAX_FILES": 5,      // keep this many rotated files (default: 5)

  // Providers — just credentials. Base URLs are built-in defaults.
  // Use "$ENV_VAR" to reference environment variables.
  "Providers": {
    "anthropic": "$ANTHROPIC_API_KEY",
    "openrouter": "$OPENROUTER_API_KEY",
    "gemini": "$GEMINI_API_KEY",
    "openai": "$OPENAI_API_KEY",
    "groq": "$GROQ_API_KEY",
    "mistral": "$MISTRAL_API_KEY",
    "ollama": "ollama"
  },

  // Named route sets — different model mixes for different scenarios.
  // Each tier value: "providerName,modelName" — split on first comma.
  // "sonnet" is required (also the fallback). "opus" and "haiku" are optional.
  // Claude Code sends model names like "claude-sonnet-4-20250514" — the proxy
  // classifies them by tier (opus/sonnet/haiku) and routes accordingly.
  "Routes": {
    "direct": {
      "opus":   "anthropic,claude-opus-4-20250514",
      "sonnet": "anthropic,claude-sonnet-4-20250514",
      "haiku":  "anthropic,claude-haiku-4-5-20241022"
    },
    "mixed": {
      "opus":   "openrouter,google/gemini-2.5-pro-preview",
      "sonnet": "anthropic,claude-sonnet-4-20250514",
      "haiku":  "groq,llama-3.3-70b-versatile"
    },
    "cheap": {
      "sonnet": "gemini,gemini-2.5-flash",
      "haiku":  "gemini,gemini-2.5-flash"
    }
  },

  // Which route set to use by default. Override with: ccasr start --route mixed
  "ActiveRoute": "direct"
}
